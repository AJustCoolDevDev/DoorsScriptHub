-- Анимация загрузки (10 секунд) и ошибки
task.spawn(function()
	local tweenService = game:GetService("TweenService")
	local info = TweenInfo.new(10, Enum.EasingStyle.Linear)
	
	local tween = tweenService:Create(LoadingBarFill, info, {Size = UDim2.new(1, 0, 1, 0)})
	tween:Play()
	tween.Completed:Wait()
	
	-- Смена стиля на «ошибка»
	LoadingBarFill.BackgroundColor3 = Color3.fromRGB(255, 75, 75)
	LoadingBarBg.Visible = false 
	Title.TextColor3 = Color3.fromRGB(255, 75, 75)
	Title.Text = "Ошибка: Требуется покупка!"
	StatusLabel.Text = "Для доступа к скрипту купите его в боте:\n@speedhubx_bot"
	StatusLabel.TextColor3 = Color3.fromRGB(230, 230, 230)
	
	-- Показываем интерактивную кнопку
	CopyButton.Visible = true
end)

-- Обработка клика по кнопке копирования
CopyButton.MouseButton1Click:Connect(function()
	local success = pcall(function()
		setclipboard("https://t.me/speedhubx_bot")
	end)
	
	if success then
		CopyButton.Text = "✅ Ссылка скопирована!"
		CopyButton.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
		task.wait(2)
		CopyButton.Text = "📋 Скопировать ссылку на бота"
		CopyButton.BackgroundColor3 = Color3.fromRGB(0, 170, 255)
	else
		CopyButton.Text = "❌ Ошибка копирования"
		task.wait(2)
		CopyButton.Text = "📋 Скопировать ссылку на бота"
	end
end)

-- Обработка закрытия интерфейса
